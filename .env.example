# Copy to .env and fill in. .env is gitignored. Every variable the code reads from the environment is listed here.
# Leave a value empty when you don't use it: the code treats any non-empty value as set.

# Apify API token (apify.com > Settings > Integrations): every listing source runs through Apify actors. Needed to gather. Example: apify_api_...
APIFY_TOKEN=
# Google Maps Platform key with Routes, Places (New) and Geocoding enabled (optional: real commute times,
# Places search, address geocoding; capped in config/google.toml). Example: AIza...
GOOGLE_MAPS_API_KEY=

# Public dashboard (optional, nix run .#tunnel). The Cloudflare tunnel token only, not the whole docker/cloudflared
# command. The tunnel's public hostname (e.g. app.example.com, service http://localhost:8765) is set in the
# Cloudflare dashboard, never in this repo.
CLOUDFLARED_TOKEN=
# Serve the dashboard only under this secret path, e.g. /SomeLongPhrase. Never commit the real value
# (scripts/check_secrets.sh, AGENTS.md rule 10).
APTF_BASE_PATH=
# Dashboard port (default 8765; nix run .#tunnel and scripts/deploy.sh)
# APTF_PORT=8765

# Locations, all optional (defaults: the repo root, config/ or else config.example/, data/, data/apartments.db)
# APTF_ROOT=
# APTF_CONFIG=
# APTF_DATA=
# APTF_DB=
